{
  "name": "nooblol",
  "productName": "Noob LOL",
  "version": "3.11.3",
  "description": "Compagnon de jeu League of Legends pour débutants : préparation, sélection des champions et aide en jeu.",
  "author": "Carottejy",
  "license": "UNLICENSED",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "simulateur": "electron . --simulateur"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "sql.js": "1.15.1",
    "selfsigned": "2.4.1"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.carottejy.nooblol",
    "productName": "Noob LOL",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Noob LOL",
      "artifactName": "Noob-LOL-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Carottejy",
        "repo": "NoobLol",
        "releaseType": "draft"
      }
    ],
    "fileAssociations": [
      {
        "ext": "nooblolstats",
        "name": "Statistiques Noob LOL",
        "description": "Statistiques du collecteur Noob LOL",
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "seed",
        "to": "seed",
        "filter": [
          "*.nooblolstats"
        ]
      }
    ]
  }
}
